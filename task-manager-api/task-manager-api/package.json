{
  "name": "task-manager-api",
  "version": "1.0.0",
  "description": "Task Manager Backend API - Node.js, Express, MongoDB, JWT auth, RBAC, Docker, AWS EC2",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "seed:large": "node scripts/seed.js --tasks=100000",
    "explain": "node scripts/explain.js",
    "benchmark": "node scripts/benchmark.js",
    "test": "jest --runInBand --forceExit",
    "indexes:drop": "node scripts/toggle-indexes.js drop",
    "indexes:create": "node scripts/toggle-indexes.js create"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
